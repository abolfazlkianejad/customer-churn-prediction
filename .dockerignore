.coverage.*
htmlcov
coverage.xml
junit.xml

# Notebooks and tests are not part of the serving image
notebooks
tests
.ipynb_checkpoints

# Datasets and local stores must never enter the image
data
*.csv
*.parquet
*.feather
*.db
*.sqlite
*.sqlite3

# Environment secrets
.env
.env.*
!.env.example

# Logs, temporary files, and OS files
*.log
*.tmp
*.temp
*.bak
*.swp
.DS_Store
Thumbs.db

# Development-only files
scripts
requirements-dev.txt

# Model artifacts are supplied at runtime through a read-only bind mount.
artifacts
