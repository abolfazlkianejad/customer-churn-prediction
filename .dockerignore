# Version control and editor state
.git
.gitignore
.gitattributes
.github
.idea
.vscode

# Virtual environments
.venv
venv
env
ENV

# Python caches and build output
__pycache__
*.py[cod]
*$py.class
build
dist
*.egg-info
.eggs
*.whl

