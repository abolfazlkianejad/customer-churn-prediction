# Copy this file to `.env` and adjust values for your environment.
# All settings use the SMARTPREDICT_ prefix (see src/smartpredict/config/settings.py).

SMARTPREDICT_ENVIRONMENT=development
SMARTPREDICT_DEBUG=false

# Logging: console | json
SMARTPREDICT_LOG_LEVEL=INFO
SMARTPREDICT_LOG_FORMAT=console
SMARTPREDICT_LOG_TO_FILE=false

# Reproducibility
SMARTPREDICT_RANDOM_SEED=42

# Data / experiment configuration
SMARTPREDICT_TARGET_COLUMN=Churn
SMARTPREDICT_ID_COLUMN=customerID
SMARTPREDICT_CONFIGS_DIR=configs

# Artifact storage
SMARTPREDICT_ARTIFACTS_DIR=artifacts
# Optional explicit model bundle directory; defaults to $ARTIFACTS_DIR/models.
# SMARTPREDICT_MODELS_DIR=/mnt/models
# Docker Compose host-side model directory (mounted read-only at /app/artifacts/models).
# SMARTPREDICT_HOST_MODELS_DIR=./artifacts/models
SMARTPREDICT_MODEL_NAME=churn_xgboost
SMARTPREDICT_MODEL_VERSION=v1

# API server
SMARTPREDICT_API_HOST=0.0.0.0
SMARTPREDICT_API_PORT=8000
SMARTPREDICT_API_PREFIX=/api/v1
# Optional container health-check override; defaults to the API health route.
# SMARTPREDICT_HEALTHCHECK_URL=http://127.0.0.1:8000/api/v1/health
SMARTPREDICT_HEALTHCHECK_TIMEOUT_SECONDS=3.0
